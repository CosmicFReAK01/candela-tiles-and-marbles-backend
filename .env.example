# ==============================================================================
# CANDELA TILES & MARBLES — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local runtime or configure directly in hosting provider.
# NEVER commit production credentials, passwords, or connection secrets to Git.
# ==============================================================================

# Server Port (default: 8080)
PORT=

# Database Connection (PostgreSQL 15+)
# Set DATABASE_URL as a standard JDBC URL or connection URI (e.g. Supabase, Render Postgres)
# Do NOT include credentials in committed files.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Database Connection Pool (HikariCP)
DB_MAX_POOL_SIZE=

# Hibernate DDL Auto (Use 'none' or 'validate' in production)
HIBERNATE_DDL_AUTO=

# JWT Authentication Secret
# Must be a cryptographically secure random string with at least 32 characters (256 bits).
# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=
REFRESH_TOKEN_EXPIRATION_DAYS=

# CORS Configuration (Comma-separated allowed origins)
# Example: https://candelatiles.in,https://admin.candelatiles.in
ALLOWED_ORIGINS=

# Initial Administrator Bootstrap (Only evaluated when user table is completely empty)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Object Storage Configuration (Supabase Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
